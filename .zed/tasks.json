[
  {
    "label": "flutter run (With Env)",
    "command": "flutter",
    "args": ["run", "--dart-define-from-file", "env.json", "--no-enable-impeller"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },
  {
    "label": "flutter run (Safe Mode)",
    "command": "flutter",
    "args": [
      "run",
      "--dart-define-from-file",
      "env.json",
      "--dart-define=SAFE_MODE=true",
      "--no-enable-impeller",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },
]
